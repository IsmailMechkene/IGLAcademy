{
  "name": "ismalearn",
  "version": "1.0.0",
  "description": "IsmaLearn — Your courses. Your pace. Your progress.",
  "main": "dist-electron/main.js",
  "author": "IsmaLearn",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/ensure-abi.mjs electron && node scripts/dev.mjs",
    "build": "vite build && npm run build:electron",
    "build:electron": "node scripts/ensure-abi.mjs electron && node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/ensure-abi.mjs node && vitest run",
    "rebuild:electron": "npx electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:prepackaged": "electron-builder --win nsis --prepackaged release/win-unpacked",
    "brand-exe": "node scripts/brand-exe.mjs",
    "icon": "node scripts/generate-icon.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "postinstall": "node scripts/ensure-abi.mjs electron"
}
