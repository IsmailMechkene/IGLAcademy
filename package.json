{
  "name": "iglacademy",
  "version": "1.0.1",
  "description": "IGLAcademy — Your courses. Your pace. Your progress.",
  "main": "dist-electron/main.js",
  "author": "IGLAcademy",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/ensure-abi.mjs electron && node scripts/dev.mjs",
    "build": "vite build && npm run build:electron",
    "build:electron": "node scripts/ensure-abi.mjs electron && node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/ensure-abi.mjs node && vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "smoke": "node scripts/smoke-package.mjs",
    "rebuild:electron": "npx electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:prepackaged": "electron-builder --win nsis --publish never --prepackaged release/win-unpacked",
    "installer": "npm run dist && npm run brand-exe && npm run dist:prepackaged",
    "brand-exe": "node scripts/brand-exe.mjs",
    "icon": "node scripts/generate-icon.mjs",
    "postinstall": "node scripts/ensure-abi.mjs electron"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.10",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
